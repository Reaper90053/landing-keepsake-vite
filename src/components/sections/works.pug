section#works.works.section
  .container
    .section-header
      span.section-header__label Portfolio
      h2.section-header__title Selected Works

    .works-filter
      each cat in filterCategories
        input.works-filter__radio(
          type='radio',
          name='portfolio-filter',
          id=cat.id,
          checked=cat.checked
        )

      .works-filter__chips(role='tablist', aria-label='Filter portfolio by category')
        each cat in filterCategories
          label.works-filter__chip(for=cat.id) #{ cat.label }

      ul.works-grid
        each work, i in works
          li.works-grid__item(data-category=work.category)
            +work-card(work, i < 2)
