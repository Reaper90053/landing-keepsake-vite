section#services.services.section
  .container
    .section-header
      span.section-header__label What We Do
      h2.section-header__title Our Services

    ul.services-grid
      each service in services
        li.service-card
          .service-card__icon
            +icon(service.icon, 32)
          h3.service-card__title #{service.title}
          p.service-card__text #{service.text}