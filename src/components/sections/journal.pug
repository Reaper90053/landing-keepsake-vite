section#journal.journal.section
  .container
    .section-header
      span.section-header__label Insights &amp; Stories
      h2.section-header__title From The Journal

    ul.journal-grid
      each post in journalPosts
        li.journal-card
          .journal-card__media
            +picture(post.image, post.alt, true, '(min-width: 768px) 220px, 100vw')
          .journal-card__body
            .journal-card__meta
              time.journal-card__date(datetime=post.datetime) #{post.date}
              span.journal-card__category #{post.category}
            h3.journal-card__title
              a(href=`#post-${post.image}`) #{post.title}
            p.journal-card__excerpt #{post.excerpt}