section#about.testimonial.section
  .container
    figure.testimonial-card
      blockquote.testimonial-card__quote
        p
          | “Working with Keepsake transformed how our customers perceive our brand. Their attention to typography, grid structure, and storytelling exceeded every expectation.”
      figcaption.testimonial-card__author
        .testimonial-card__avatar
          +picture('avatar-client', 'Portrait of Elena Vance', true, '64px')
        .testimonial-card__info
          cite.testimonial-card__name Elena Vance
          span.testimonial-card__role Creative Director at Pure Bloom
