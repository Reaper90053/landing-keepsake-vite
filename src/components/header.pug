.container.header__container
  a.logo(href='#home', aria-label='Keepsake Home')
    span.logo__mark K
    span.logo__text Keepsake

  input#burger-toggle.header__burger-checkbox(type='checkbox', aria-hidden='true')
  label.header__burger-btn(for='burger-toggle', aria-label='Toggle navigation menu')
    span.header__burger-line
    span.header__burger-line
    span.header__burger-line

  nav.nav(aria-label='Primary Navigation')
    ul.nav__list
      each item in navLinks
        li.nav__item
          a.nav__link(href=item.href, class={ 'nav__link--active': item.active }) #{ item.text }

  .header__actions
    +btn('Get in touch', '#contact', 'primary')(aria-label='Contact Keepsake agency')
