mixin picture(name, alt, isLazy = true, sizes = '(min-width: 1280px) 360px, (min-width: 768px) 50vw, 100vw', width = 800, height = 600)
  picture
    source(
      type="image/avif"
      srcset=`/src/assets/images/${name}-400.avif 400w, /src/assets/images/${name}-800.avif 800w`
      sizes=sizes
    )
    source(
      type="image/webp"
      srcset=`/src/assets/images/${name}-400.webp 400w, /src/assets/images/${name}-800.webp 800w`
      sizes=sizes
    )
    if isLazy
      img(
        src=`/src/assets/images/${name}-800.jpg`
        srcset=`/src/assets/images/${name}-400.jpg 400w, /src/assets/images/${name}-800.jpg 800w`
        sizes=sizes
        alt=alt
        width=width
        height=height
        loading="lazy"
        decoding="async"
      )&attributes(attributes)
    else
      img(
        src=`/src/assets/images/${name}-800.jpg`
        srcset=`/src/assets/images/${name}-400.jpg 400w, /src/assets/images/${name}-800.jpg 800w`
        sizes=sizes
        alt=alt
        width=width
        height=height
        fetchpriority="high"
      )&attributes(attributes)